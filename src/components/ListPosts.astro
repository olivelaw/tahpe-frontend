---
import type { BlogPostEntry } from '@/data/posts'
import PostCard from '@/components/PostCard'
import { cn } from '@/utils'

type Props = {
	posts: BlogPostEntry[]
	FirstBig?: boolean
}

const { posts, FirstBig = false } = Astro.props
---

<section
	class={cn(
		`grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3  gap-8 mt-3`,
		FirstBig && `md:[&>*:first-child]:col-span-2`
	)}
>
	{
		posts.map((post) => (
			<PostCard id={post.id} data={post.data} slug={post.slug} readTime={post.readTime} />
		))
	}
</section>
