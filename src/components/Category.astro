---
import { cn, sluglify } from '@/utils'

const { name = 'View All', activeCategory } = Astro.props
const currentPath = Astro.url.pathname
const unsluglifyNameCategory = sluglify(name.toLowerCase())

const isActive =
	activeCategory?.toLocaleLowerCase() === unsluglifyNameCategory ||
	(currentPath === '/' && name === 'View All')
---

<a
	href={name === 'View All' ? '/' : sluglify(`/category/${unsluglifyNameCategory}/1`)}
	class={cn(
		`pb-2.5 first-letter:uppercase font-medium border-b-2 border-transparent transition-colors duration-150 ease-linear`,
		`text-black hover:text-tahpe-blue hover:border-tahpe-blue dark:text-tahpe-blue dark:hover:text-white dark:hover:border-white`,
		isActive && `border-tahpe-navy text-tahpe-navy z-10 dark:border-tahpe-blue dark:text-tahpe-blue`
	)}
>
	{name}
</a>
