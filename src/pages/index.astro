---
import ListCategories from '@/components/ListCategories'
import ListPosts from '@/components/ListPosts'
import BaseLayout from '@/layouts/BaseLayout'
import { getPosts } from '@/utils'

const MAX_POSTS = 12 // newspaper-style: show more stories on the front page
const posts = await getPosts(MAX_POSTS)
---

<BaseLayout title='Home'>
	<ListCategories />

	<div>
		<h2
			class='text-xl font-display font-bold text-black border-b-2 border-zinc-600 pb-2 mb-6 uppercase tracking-wider dark:text-white dark:border-zinc-300'
		>
			Today's headlines
		</h2>
		<ListPosts FirstBig={true} posts={posts} />
	</div>
</BaseLayout>

<script>
	import { animate } from 'motion'
	const showAnimations = localStorage.getItem('animations') === 'true'

	if (showAnimations) {
		animate(
			'.title',
			{ y: [80, 0], opacity: [0, 1] },
			{
				duration: 2.5,
				opacity: { duration: 3 },

				offset: [0, 0.55, 0.75]
			}
		)
	}
</script>
