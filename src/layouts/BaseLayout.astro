---
import BaseHead from '@/components/BaseHead'
import Header from '@/components/Header'
import Footer from '@/components/Footer'
import ProviderTheme from '@/components/ProviderTheme'
import ProviderAnimations from '@/components/ProviderAnimations'
import TwSizeIndicator from '@/components/TwSizeIndicator'
const { title, description, image, articleDate } = Astro.props
---

<html lang='en' class='scroll-smooth'>
	<head>
		<BaseHead title={title} description={description} ogImage={image} articleDate={articleDate} />
		<ProviderTheme />
		<ProviderAnimations />
	</head>

	<body class='bg-paper text-ink dark:bg-[#1a1a1a] dark:text-paper'>
		<div class='w-full'>
			<Header />
		</div>
		<main
			class='px-4 sm:mx-auto sm:max-w-2xl sm:px-6 lg:px-4 antialiased md:max-w-6xl gap-10 mt-6 overflow-hidden md:overflow-visible font-body border-x border-zinc-400/20 md:min-h-screen'
		>
			<slot />
		</main>
		<div class='w-full'>
			<Footer />
		</div>
		<style>
			body {
				margin-left: calc(100vw - 100%); /* prevent layout shift */
			}
		</style>
	</body>
</html>
